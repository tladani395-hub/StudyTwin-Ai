# StudyTwin-AI / Aanvi Production Environment Template (Render Backend)
# Copy this to your Render / Railway environment variables dashboard.

PORT=8000
DATABASE_URL=postgresql://studytwin_user:your_secure_password@your-neon-or-render-postgres-host/studytwin_db?sslmode=require
GEMINI_API_KEY=YOUR_SECURE_ROTATED_GEMINI_API_KEY
LLM_API_KEY=YOUR_SECURE_ROTATED_GEMINI_API_KEY
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REPETITION_THRESHOLD=0.70
ALLOWED_ORIGINS=https://your-frontend.vercel.app
